# Base API security
POLYOCR_AUTH_ENABLED=true
POLYOCR_API_KEY=change-me
POLYOCR_CORS_ORIGINS=http://localhost:8000
POLYOCR_CORS_ALLOW_CREDENTIALS=false

# OCR resource bounds
POLYOCR_MAX_UPLOAD_MB=10
POLYOCR_MAX_IMAGE_PIXELS=25000000
POLYOCR_MAX_CONCURRENCY=2
POLYOCR_OCR_WORKERS=2
POLYOCR_DEFAULT_LANGUAGE=ch

# Translation provider and bounds
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.openai.com/v1
TRANSLATION_MODEL=gpt-4o-mini
POLYOCR_MAX_TRANSLATION_ITEMS=50
POLYOCR_MAX_TRANSLATION_CHARS=20000

# Optional PaddleOCR-VL service (always authenticated)
POLYOCR_VL_API_KEY=change-me-too
POLYOCR_VL_MAX_UPLOAD_MB=20
